{
  "name": "polymarket-crypto-analyzer-bot",
  "version": "0.1.0",
  "description": "Bot local y gratuito de analisis y simulacion para mercados crypto de Polymarket.",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "api": "tsx watch src/modules/api/api.server.ts",
    "web": "vite --config apps/web/vite.config.ts",
    "dev:all": "concurrently \"npm run api\" \"npm run web\"",
    "build": "tsc",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop polymarket-crypto-analyzer-bot",
    "pm2:logs": "pm2 logs polymarket-crypto-analyzer-bot",
    "pm2:restart": "pm2 restart polymarket-crypto-analyzer-bot --update-env",
    "pm2:save": "pm2 save",
    "report": "tsx src/modules/reports/report.ts",
    "backtest:short-exit": "tsx scripts/backtest-short-term-exit.ts",
    "backtest:order-flow": "tsx scripts/backtest-order-flow-l1.ts",
    "analyze:short-exit": "tsx scripts/analyze-live-short-term-exit-patterns.ts",
    "analyze:current-timeframe-exits": "tsx scripts/analyze-current-timeframe-exits.ts",
    "analyze:prediction-gates": "tsx scripts/analyze-prediction-order-gates.ts",
    "report:short-exit": "tsx scripts/report-short-term-exit-live.ts",
    "report:realistic-short-exit": "tsx scripts/report-realistic-short-exit.ts",
    "report:daily-exit": "tsx scripts/report-daily-exit.ts",
    "backfill:daily-exit-stake-3": "tsx scripts/scale-daily-exit-stake-to-three.ts",
    "backfill:short-exit-scenarios": "tsx scripts/backfill-short-term-exit-scenarios.ts",
    "audit:run-storage": "tsx scripts/audit-run-storage.ts",
    "cleanup:database": "tsx scripts/cleanup-database.ts",
    "cleanup:database:vacuum": "tsx scripts/cleanup-database.ts --vacuum",
    "backup:now": "tsx scripts/create-backup.ts",
    "close:short-exit": "tsx scripts/close-expired-short-term-exit.ts",
    "backfill:historical-gate": "tsx scripts/backfill-historical-gate-observations.ts",
    "resolve:observations": "tsx scripts/resolve-observations.ts",
    "verify:historical-gate": "tsx scripts/verify-historical-gate-learning.ts",
    "prisma:status": "prisma migrate status",
    "export:ml-dataset": "tsx src/modules/learning/export-ml-dataset.ts",
    "ml:train-entry-risk": "tsx scripts/train-entry-risk-model.ts",
    "ml:analyze-shadow": "tsx scripts/analyze-entry-risk-shadow.ts",
    "ml:train-outcome": "tsx scripts/train-outcome-model.ts",
    "ml:train-outcome-candidate": "tsx scripts/train-outcome-model-candidate.ts",
    "ml:analyze-outcome-shadow": "tsx scripts/analyze-outcome-shadow.ts",
    "ml:report-outcome-execution-shadow": "tsx scripts/report-ml-outcome-execution-shadow.ts",
    "report:higher-timeframe-outcome": "tsx scripts/report-higher-timeframe-outcome-observation.ts",
    "generate:polymarket-api-keys": "tsx scripts/generate-polymarket-api-credentials.ts",
    "check:polymarket-balance": "tsx scripts/check-polymarket-balance.ts"
  },
  "keywords": [
    "polymarket",
    "crypto",
    "simulation",
    "typescript",
    "prisma",
    "sqlite"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@polymarket/clob-client-v2": "^1.0.6",
    "@prisma/client": "^5.22.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "dotenv": "^16.4.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.8.1",
    "viem": "^2.52.2",
    "vite": "^8.0.16",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "pm2": "^5.4.3",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  }
}
