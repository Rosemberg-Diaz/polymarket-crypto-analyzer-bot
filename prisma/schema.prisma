generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Market {
  id               String            @id @default(cuid())
  externalMarketId String?           @unique
  slug             String?           @unique
  question         String
  category         String            @default("CRYPTO")
  assetSymbol      String
  baseAsset        String?
  quoteAsset       String?
  marketType       String
  timeframe        String?
  active           Boolean           @default(true)
  closed           Boolean           @default(false)
  startDate        DateTime?
  endDate          DateTime?
  resolutionSource String?
  rawData          String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  outcomes         MarketOutcome[]
  snapshots        MarketSnapshot[]
  predictions      BotPrediction[]
  simulatedTrades  SimulatedTrade[]
  realOrders       RealOrder[]
  observationEvaluations ObservationEvaluation[]
  shortTermExitObservations ShortTermExitObservation[]
  shortTermEntryQuotes ShortTermEntryQuote[]
  realisticShortExitExecutions RealisticShortExitExecution[]
  liveShortExitTrades LiveShortExitTrade[]
  dailyExitCycles DailyExitCycle[]
  dailyMarketQuotes DailyMarketQuote[]
  mlOutcomeShadowExecutions MlOutcomeShadowExecution[]
  liveOutcomeCheckpointTrades LiveOutcomeCheckpointTrade[]

  @@index([assetSymbol])
  @@index([marketType])
  @@index([createdAt])
  @@index([category, marketType, timeframe, active, closed, endDate])
}

model MarketOutcome {
  id              String   @id @default(cuid())
  marketId        String
  market          Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  externalTokenId String?
  name            String
  normalizedName  String
  currentPrice    Decimal?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([marketId])
  @@index([externalTokenId])
  @@index([createdAt])
}

model MarketSnapshot {
  id                      String          @id @default(cuid())
  marketId                String
  market                  Market          @relation(fields: [marketId], references: [id], onDelete: Cascade)
  upPrice                 Decimal?
  downPrice               Decimal?
  yesPrice                Decimal?
  noPrice                 Decimal?
  bid                     Decimal?
  ask                     Decimal?
  spread                  Decimal?
  liquidity               Decimal?
  volume                  Decimal?
  targetPrice             Decimal?
  currentAssetPrice       Decimal?
  distanceToTarget        Decimal?
  distanceToTargetPercent Decimal?
  secondsToClose          Int?
  momentumLast30s         Decimal?
  momentumLast60s         Decimal?
  momentumLast120s        Decimal?
  volatilityLast60s       Decimal?
  volatilityLast120s      Decimal?
  rawOrderbook            String?
  rawData                 String?
  createdAt               DateTime        @default(now())
  predictions             BotPrediction[]

  @@index([marketId])
  @@index([createdAt])
  @@index([marketId, createdAt])
}

model BotPrediction {
  id                 String           @id @default(cuid())
  marketId           String
  market             Market           @relation(fields: [marketId], references: [id], onDelete: Cascade)
  snapshotId         String
  snapshot           MarketSnapshot   @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  strategyName       String
  assetSymbol        String
  marketType         String
  predictedOutcome   String
  entryPrice         Decimal
  impliedProbability Decimal?
  botProbability     Decimal?
  edge               Decimal?
  confidence         Decimal?
  recommendation     String
  reason             String?
  features           String?
  historicalSummary  String?
  mlOutcomePrediction String?
  mlProbabilityUp     Decimal?
  mlProbabilityDown   Decimal?
  mlOutcomeEntryPrice Decimal?
  mlOutcomeModelVersion String?
  mlOutcomeFeatures   String?
  mlOutcomeScoredAt   DateTime?
  createdAt          DateTime         @default(now())
  simulatedTrades    SimulatedTrade[]
  realOrders          RealOrder[]
  observationEvaluation ObservationEvaluation?
  mlOutcomeShadowExecution MlOutcomeShadowExecution?
  liveOutcomeCheckpointTrade LiveOutcomeCheckpointTrade?

  @@index([marketId])
  @@index([snapshotId])
  @@index([assetSymbol])
  @@index([marketType])
  @@index([strategyName])
  @@index([mlOutcomePrediction])
  @@index([createdAt])
  @@index([marketId, strategyName, createdAt])
}

model SimulatedTrade {
  id           String        @id @default(cuid())
  predictionId String
  prediction   BotPrediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  marketId     String
  market       Market        @relation(fields: [marketId], references: [id], onDelete: Cascade)
  stake        Decimal
  entryPrice   Decimal
  shares       Decimal
  status       String        @default("PENDING")
  result       String?
  isWin        Boolean?
  finalValue   Decimal?
  profit       Decimal?
  roi          Decimal?
  resolvedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  realOrders   RealOrder[]

  @@index([predictionId])
  @@index([marketId])
  @@index([status])
  @@index([createdAt])
  @@index([resolvedAt])
}

model RealOrder {
  id                 String          @id @default(cuid())
  predictionId       String
  prediction         BotPrediction   @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  simulatedTradeId   String?
  simulatedTrade     SimulatedTrade? @relation(fields: [simulatedTradeId], references: [id], onDelete: SetNull)
  marketId           String
  market              Market          @relation(fields: [marketId], references: [id], onDelete: Cascade)
  externalOrderId    String?          @unique
  assetSymbol        String
  marketType         String
  predictedOutcome   String
  entryRule          String
  stake              Decimal
  requestedPrice     Decimal
  requestedShares    Decimal
  status             String
  errorMessage       String?
  responseData       String?
  submittedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([predictionId])
  @@index([simulatedTradeId])
  @@index([marketId])
  @@index([assetSymbol])
  @@index([marketType])
  @@index([entryRule])
  @@index([status])
  @@index([submittedAt])
  @@index([createdAt])
}

model ObservationEvaluation {
  id               String        @id @default(cuid())
  predictionId     String        @unique
  prediction       BotPrediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  marketId         String
  market           Market        @relation(fields: [marketId], references: [id], onDelete: Cascade)
  observationType  String
  hypotheticalStake Decimal
  entryPrice       Decimal
  shares           Decimal
  status           String        @default("PENDING")
  result           String?
  wouldWin         Boolean?
  finalValue       Decimal?
  hypotheticalProfit Decimal?
  hypotheticalRoi  Decimal?
  resolutionSource String?
  resolvedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([marketId])
  @@index([observationType])
  @@index([status])
  @@index([createdAt])
  @@index([resolvedAt])
}

model MlOutcomeShadowExecution {
  id                   String        @id @default(cuid())
  predictionId         String        @unique
  prediction           BotPrediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  marketId             String
  market               Market        @relation(fields: [marketId], references: [id], onDelete: Cascade)
  assetSymbol          String
  timeframe            String
  predictedOutcome     String
  tokenId              String
  checkpointSeconds    Int
  actualSecondsToClose Int
  requestedBudget      Decimal
  status               String
  skipReason           String?
  minOrderSize         Decimal?
  tickSize             Decimal?
  bestAsk              Decimal?
  worstFillPrice       Decimal?
  averageEntryPrice    Decimal?
  shares               Decimal?
  grossCost            Decimal?
  fee                  Decimal?
  totalCost            Decimal?
  slippage             Decimal?
  modelProbability     Decimal?
  expectedProfit       Decimal?
  expectedRoi          Decimal?
  fullyFilled          Boolean       @default(false)
  latencyMs            Int
  bookTimestamp        String?
  bookFingerprint      String?
  officialWinner       String?
  resolutionSource     String?
  isWin                Boolean?
  finalValue           Decimal?
  profit               Decimal?
  roi                  Decimal?
  resolvedAt           DateTime?
  liveOutcomeCheckpointTrade LiveOutcomeCheckpointTrade?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@unique([marketId, checkpointSeconds])
  @@index([assetSymbol])
  @@index([timeframe])
  @@index([predictedOutcome])
  @@index([status])
  @@index([createdAt])
  @@index([resolvedAt])
}

model LiveOutcomeCheckpointTrade {
  id                   String                   @id @default(cuid())
  shadowExecutionId    String                   @unique
  shadowExecution      MlOutcomeShadowExecution @relation(fields: [shadowExecutionId], references: [id], onDelete: Cascade)
  predictionId         String                   @unique
  prediction           BotPrediction            @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  marketId             String
  market               Market                   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  assetSymbol          String
  timeframe            String
  predictedOutcome     String
  tokenId              String
  checkpointSeconds    Int
  status               String                   @default("ENTRY_ATTEMPTING")
  budget               Decimal
  requestedMaxPrice    Decimal
  externalOrderId      String?
  filledShares         Decimal                  @default(0)
  cashAmount           Decimal                  @default(0)
  averagePrice         Decimal?
  responseData         String?
  errorMessage         String?
  officialWinner       String?
  resolutionSource     String?
  isWin                Boolean?
  finalValue           Decimal?
  profit               Decimal?
  roi                  Decimal?
  openedAt             DateTime?
  resolvedAt           DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([marketId])
  @@index([assetSymbol])
  @@index([timeframe])
  @@index([predictedOutcome])
  @@index([checkpointSeconds])
  @@index([status])
  @@index([createdAt])
  @@index([resolvedAt])
}

model ShortTermExitObservation {
  id                    String   @id @default(cuid())
  marketId              String
  market                Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  assetSymbol           String
  outcome               String
  strategyVersion       String   @default("CHEAP_REBOUND_V1")
  entryBand             String   @default("DEFAULT")
  entryTrigger          String?
  status                String   @default("OPEN")
  stake                 Decimal
  entryAsk              Decimal
  entryBid              Decimal
  entrySpread           Decimal
  shares                Decimal
  buyFee                Decimal
  entrySecondsToClose   Int
  maxExecutableBid      Decimal
  minExecutableBid      Decimal
  maxNetRoi             Decimal  @default(0)
  minNetRoi             Decimal  @default(0)
  firstTakeProfit2At    DateTime?
  firstTakeProfit3At    DateTime?
  firstTakeProfit5At    DateTime?
  firstTakeProfit10At   DateTime?
  firstStopLoss3At      DateTime?
  firstStopLoss5At      DateTime?
  firstStopLoss10At     DateTime?
  exitBid               Decimal?
  sellFee               Decimal?
  finalValue            Decimal?
  profit                Decimal?
  roi                   Decimal?
  exitReason            String?
  exitedAt              DateTime?
  mlRiskLabel           String?
  mlRiskProbability     Decimal?
  mlModelVersion        String?
  mlFeatures            String?
  mlScoredAt            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  quotes                ShortTermExitQuote[]
  exitScenarios         ShortTermExitScenario[]
  realisticExecution    RealisticShortExitExecution?
  liveTrade             LiveShortExitTrade?

  @@unique([marketId, outcome, strategyVersion, entryBand])
  @@index([assetSymbol])
  @@index([outcome])
  @@index([entryBand])
  @@index([strategyVersion])
  @@index([status])
  @@index([createdAt])
  @@index([exitedAt])
  @@index([marketId, strategyVersion])
}

model RealisticShortExitExecution {
  id                  String                   @id @default(cuid())
  observationId       String                   @unique
  observation         ShortTermExitObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  marketId            String
  market              Market                   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  assetSymbol         String
  outcome             String
  tokenId             String
  status              String                   @default("ACTIVE")
  budget              Decimal
  entryCost           Decimal
  sharesBought        Decimal
  averageEntryPrice   Decimal
  buyFees             Decimal
  sharesSold          Decimal                  @default(0)
  sellGrossProceeds   Decimal                  @default(0)
  sellFees            Decimal                  @default(0)
  remainingShares     Decimal
  settlementValue     Decimal                  @default(0)
  finalValue          Decimal?
  profit              Decimal?
  roi                 Decimal?
  exitTrigger         String?
  dataGapCount        Int                      @default(0)
  resolutionSource    String?
  officialWinner      String?
  lastObservedAt      DateTime?
  resolvedAt          DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  fills               RealisticShortExitFill[]
  bookUses            RealisticShortExitBookUse[]

  @@index([marketId])
  @@index([assetSymbol])
  @@index([outcome])
  @@index([status])
  @@index([createdAt])
  @@index([resolvedAt])
}

model RealisticShortExitFill {
  id              String                      @id @default(cuid())
  executionId     String
  execution       RealisticShortExitExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  side            String
  price           Decimal
  shares          Decimal
  grossValue      Decimal
  fee             Decimal
  netValue        Decimal
  secondsToClose  Int
  createdAt       DateTime                    @default(now())

  @@index([executionId])
  @@index([side])
  @@index([createdAt])
}

model LiveShortExitTrade {
  id                String                   @id @default(cuid())
  observationId     String                   @unique
  observation       ShortTermExitObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  marketId          String
  market            Market                   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  assetSymbol       String
  outcome           String
  tokenId           String
  strategyVersion   String
  status            String                   @default("ENTRY_ATTEMPTING")
  budget            Decimal
  entryPrice        Decimal
  entryCost         Decimal                  @default(0)
  sharesBought      Decimal                  @default(0)
  sharesSold        Decimal                  @default(0)
  remainingShares   Decimal                  @default(0)
  sellProceeds      Decimal                  @default(0)
  estimatedFees     Decimal                  @default(0)
  profit            Decimal?
  roi               Decimal?
  exitTrigger       String?
  errorMessage      String?
  openedAt          DateTime?
  closedAt          DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  orders            LiveShortExitOrder[]

  @@index([marketId])
  @@index([assetSymbol])
  @@index([status])
  @@index([createdAt])
  @@index([closedAt])
}

model LiveShortExitOrder {
  id                String             @id @default(cuid())
  tradeId           String
  trade             LiveShortExitTrade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  side              String
  externalOrderId   String?
  status            String
  requestedAmount   Decimal
  requestedPrice    Decimal?
  filledShares      Decimal            @default(0)
  cashAmount        Decimal            @default(0)
  averagePrice      Decimal?
  responseData      String?
  errorMessage      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([tradeId])
  @@index([side])
  @@index([status])
  @@index([externalOrderId])
  @@index([createdAt])
}

model DailyExitCycle {
  id                  String             @id @default(cuid())
  marketId            String
  market              Market             @relation(fields: [marketId], references: [id], onDelete: Cascade)
  assetSymbol         String
  outcome             String
  tokenId             String
  strategyVersion     String             @default("DAILY_MULTI_CYCLE_NO_STOP_V1")
  cycleNumber         Int
  status              String             @default("OPEN")
  stake               Decimal
  entryPrice          Decimal
  entrySpread         Decimal
  shares              Decimal
  buyFee              Decimal
  entryCost           Decimal
  entrySecondsToClose Int
  exitPrice           Decimal?
  sellFee             Decimal?
  finalValue          Decimal?
  profit              Decimal?
  roi                 Decimal?
  exitReason          String?
  officialWinner      String?
  resolutionSource    String?
  openedAt            DateTime           @default(now())
  closedAt            DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  quotes              DailyMarketQuote[]

  @@unique([marketId, cycleNumber])
  @@index([marketId])
  @@index([assetSymbol])
  @@index([outcome])
  @@index([status])
  @@index([strategyVersion])
  @@index([createdAt])
  @@index([closedAt])
  @@index([status, marketId])
}

model DailyMarketQuote {
  id             String          @id @default(cuid())
  marketId       String
  market         Market          @relation(fields: [marketId], references: [id], onDelete: Cascade)
  cycleId        String?
  cycle          DailyExitCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  assetSymbol    String
  outcome        String
  bestBid        Decimal
  bidSize        Decimal
  bestAsk        Decimal
  askSize        Decimal
  spread         Decimal
  secondsToClose Int
  executable     Boolean         @default(true)
  createdAt      DateTime        @default(now())

  @@index([marketId, outcome])
  @@index([cycleId])
  @@index([assetSymbol])
  @@index([createdAt])
  @@index([marketId, outcome, createdAt])
}

model RealisticShortExitBookUse {
  id              String                      @id @default(cuid())
  executionId     String
  execution       RealisticShortExitExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  side            String
  fingerprint     String
  secondsToClose  Int
  createdAt       DateTime                    @default(now())

  @@unique([executionId, side, fingerprint])
  @@index([executionId])
  @@index([createdAt])
}

model ShortTermExitScenario {
  id                String                   @id @default(cuid())
  observationId     String
  observation       ShortTermExitObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  thresholdSeconds  Int
  status            String                   @default("PENDING")
  exitReason        String?
  exitBid           Decimal?
  finalValue        Decimal?
  profit            Decimal?
  roi               Decimal?
  evaluatedAt       DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@unique([observationId, thresholdSeconds])
  @@index([thresholdSeconds])
  @@index([status])
  @@index([createdAt])
}

model ShortTermEntryQuote {
  id              String   @id @default(cuid())
  marketId        String
  market          Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  assetSymbol     String
  outcome         String
  bestBid         Decimal
  bidSize         Decimal
  bestAsk         Decimal
  askSize         Decimal
  bidDepth5       Decimal?
  askDepth5       Decimal?
  depthImbalance  Decimal?
  microPrice      Decimal?
  spread          Decimal
  liquidity       Decimal
  secondsToClose  Int
  executable      Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([marketId, outcome])
  @@index([assetSymbol])
  @@index([createdAt])
  @@index([marketId, outcome, createdAt])
}

model ShortTermExitQuote {
  id              String                   @id @default(cuid())
  observationId   String
  observation     ShortTermExitObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  bestBid         Decimal
  bidSize         Decimal
  bestAsk         Decimal
  askSize         Decimal
  bidDepth5       Decimal?
  askDepth5       Decimal?
  depthImbalance  Decimal?
  microPrice      Decimal?
  spread          Decimal
  liquidity       Decimal
  secondsToClose  Int
  netExitValue    Decimal
  netProfit       Decimal
  netRoi          Decimal
  orderFlowRiskScore   Int?
  orderFlowRiskReasons String?
  executable      Boolean                  @default(true)
  createdAt       DateTime                 @default(now())

  @@index([observationId])
  @@index([createdAt])
}

model LearningStat {
  id               String   @id @default(cuid())
  strategyName     String
  marketType       String
  assetSymbol      String
  predictedOutcome String
  totalPredictions Int      @default(0)
  wins             Int      @default(0)
  losses           Int      @default(0)
  winRate          Decimal  @default(0)
  totalProfit      Decimal  @default(0)
  averageRoi       Decimal  @default(0)
  maxDrawdown      Decimal  @default(0)
  updatedAt        DateTime @updatedAt

  @@unique([strategyName, marketType, assetSymbol, predictedOutcome])
  @@index([assetSymbol])
  @@index([marketType])
  @@index([strategyName])
  @@index([updatedAt])
}

model BotRunLog {
  id        String   @id @default(cuid())
  level     String
  message   String
  context   String?
  createdAt DateTime @default(now())

  @@index([level])
  @@index([createdAt])
}

model DailyPerformance {
  id               String   @id @default(cuid())
  date             DateTime
  assetSymbol      String
  marketType       String
  totalPredictions Int      @default(0)
  totalTrades      Int      @default(0)
  wins             Int      @default(0)
  losses           Int      @default(0)
  winRate          Decimal  @default(0)
  totalProfit      Decimal  @default(0)
  averageRoi       Decimal  @default(0)
  bestStrategy     String?
  worstStrategy    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([date, assetSymbol, marketType])
  @@index([assetSymbol])
  @@index([marketType])
  @@index([createdAt])
}
