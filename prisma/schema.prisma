generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Market {
  id               String            @id @default(cuid())
  externalMarketId String?           @unique
  slug             String?           @unique
  question         String
  category         String            @default("CRYPTO")
  assetSymbol      String
  baseAsset        String?
  quoteAsset       String?
  marketType       String
  timeframe        String?
  active           Boolean           @default(true)
  closed           Boolean           @default(false)
  startDate        DateTime?
  endDate          DateTime?
  resolutionSource String?
  rawData          String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  outcomes         MarketOutcome[]
  snapshots        MarketSnapshot[]
  predictions      BotPrediction[]
  simulatedTrades  SimulatedTrade[]
  realOrders       RealOrder[]
  observationEvaluations ObservationEvaluation[]
  shortTermExitObservations ShortTermExitObservation[]

  @@index([assetSymbol])
  @@index([marketType])
  @@index([createdAt])
}

model MarketOutcome {
  id              String   @id @default(cuid())
  marketId        String
  market          Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  externalTokenId String?
  name            String
  normalizedName  String
  currentPrice    Decimal?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([marketId])
  @@index([externalTokenId])
  @@index([createdAt])
}

model MarketSnapshot {
  id                      String          @id @default(cuid())
  marketId                String
  market                  Market          @relation(fields: [marketId], references: [id], onDelete: Cascade)
  upPrice                 Decimal?
  downPrice               Decimal?
  yesPrice                Decimal?
  noPrice                 Decimal?
  bid                     Decimal?
  ask                     Decimal?
  spread                  Decimal?
  liquidity               Decimal?
  volume                  Decimal?
  targetPrice             Decimal?
  currentAssetPrice       Decimal?
  distanceToTarget        Decimal?
  distanceToTargetPercent Decimal?
  secondsToClose          Int?
  momentumLast30s         Decimal?
  momentumLast60s         Decimal?
  momentumLast120s        Decimal?
  volatilityLast60s       Decimal?
  volatilityLast120s      Decimal?
  rawOrderbook            String?
  rawData                 String?
  createdAt               DateTime        @default(now())
  predictions             BotPrediction[]

  @@index([marketId])
  @@index([createdAt])
}

model BotPrediction {
  id                 String           @id @default(cuid())
  marketId           String
  market             Market           @relation(fields: [marketId], references: [id], onDelete: Cascade)
  snapshotId         String
  snapshot           MarketSnapshot   @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  strategyName       String
  assetSymbol        String
  marketType         String
  predictedOutcome   String
  entryPrice         Decimal
  impliedProbability Decimal?
  botProbability     Decimal?
  edge               Decimal?
  confidence         Decimal?
  recommendation     String
  reason             String?
  features           String?
  historicalSummary  String?
  createdAt          DateTime         @default(now())
  simulatedTrades    SimulatedTrade[]
  realOrders          RealOrder[]
  observationEvaluation ObservationEvaluation?

  @@index([marketId])
  @@index([snapshotId])
  @@index([assetSymbol])
  @@index([marketType])
  @@index([strategyName])
  @@index([createdAt])
}

model SimulatedTrade {
  id           String        @id @default(cuid())
  predictionId String
  prediction   BotPrediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  marketId     String
  market       Market        @relation(fields: [marketId], references: [id], onDelete: Cascade)
  stake        Decimal
  entryPrice   Decimal
  shares       Decimal
  status       String        @default("PENDING")
  result       String?
  isWin        Boolean?
  finalValue   Decimal?
  profit       Decimal?
  roi          Decimal?
  resolvedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  realOrders   RealOrder[]

  @@index([predictionId])
  @@index([marketId])
  @@index([status])
  @@index([createdAt])
  @@index([resolvedAt])
}

model RealOrder {
  id                 String          @id @default(cuid())
  predictionId       String
  prediction         BotPrediction   @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  simulatedTradeId   String?
  simulatedTrade     SimulatedTrade? @relation(fields: [simulatedTradeId], references: [id], onDelete: SetNull)
  marketId           String
  market              Market          @relation(fields: [marketId], references: [id], onDelete: Cascade)
  externalOrderId    String?          @unique
  assetSymbol        String
  marketType         String
  predictedOutcome   String
  entryRule          String
  stake              Decimal
  requestedPrice     Decimal
  requestedShares    Decimal
  status             String
  errorMessage       String?
  responseData       String?
  submittedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([predictionId])
  @@index([simulatedTradeId])
  @@index([marketId])
  @@index([assetSymbol])
  @@index([marketType])
  @@index([entryRule])
  @@index([status])
  @@index([submittedAt])
  @@index([createdAt])
}

model ObservationEvaluation {
  id               String        @id @default(cuid())
  predictionId     String        @unique
  prediction       BotPrediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  marketId         String
  market           Market        @relation(fields: [marketId], references: [id], onDelete: Cascade)
  observationType  String
  hypotheticalStake Decimal
  entryPrice       Decimal
  shares           Decimal
  status           String        @default("PENDING")
  result           String?
  wouldWin         Boolean?
  finalValue       Decimal?
  hypotheticalProfit Decimal?
  hypotheticalRoi  Decimal?
  resolutionSource String?
  resolvedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([marketId])
  @@index([observationType])
  @@index([status])
  @@index([createdAt])
  @@index([resolvedAt])
}

model ShortTermExitObservation {
  id                    String   @id @default(cuid())
  marketId              String
  market                Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  assetSymbol           String
  outcome               String
  status                String   @default("OPEN")
  stake                 Decimal
  entryAsk              Decimal
  entryBid              Decimal
  entrySpread           Decimal
  shares                Decimal
  buyFee                Decimal
  entrySecondsToClose   Int
  maxExecutableBid      Decimal
  minExecutableBid      Decimal
  maxNetRoi             Decimal  @default(0)
  minNetRoi             Decimal  @default(0)
  firstTakeProfit2At    DateTime?
  firstTakeProfit5At    DateTime?
  firstTakeProfit10At   DateTime?
  firstStopLoss3At      DateTime?
  firstStopLoss5At      DateTime?
  firstStopLoss10At     DateTime?
  exitBid               Decimal?
  sellFee               Decimal?
  finalValue            Decimal?
  profit                Decimal?
  roi                   Decimal?
  exitReason            String?
  exitedAt              DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  quotes                ShortTermExitQuote[]

  @@unique([marketId, outcome])
  @@index([assetSymbol])
  @@index([outcome])
  @@index([status])
  @@index([createdAt])
  @@index([exitedAt])
}

model ShortTermExitQuote {
  id              String                   @id @default(cuid())
  observationId   String
  observation     ShortTermExitObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  bestBid         Decimal
  bidSize         Decimal
  bestAsk         Decimal
  askSize         Decimal
  spread          Decimal
  liquidity       Decimal
  secondsToClose  Int
  netExitValue    Decimal
  netProfit       Decimal
  netRoi          Decimal
  executable      Boolean                  @default(true)
  createdAt       DateTime                 @default(now())

  @@index([observationId])
  @@index([createdAt])
}

model LearningStat {
  id               String   @id @default(cuid())
  strategyName     String
  marketType       String
  assetSymbol      String
  predictedOutcome String
  totalPredictions Int      @default(0)
  wins             Int      @default(0)
  losses           Int      @default(0)
  winRate          Decimal  @default(0)
  totalProfit      Decimal  @default(0)
  averageRoi       Decimal  @default(0)
  maxDrawdown      Decimal  @default(0)
  updatedAt        DateTime @updatedAt

  @@unique([strategyName, marketType, assetSymbol, predictedOutcome])
  @@index([assetSymbol])
  @@index([marketType])
  @@index([strategyName])
  @@index([updatedAt])
}

model BotRunLog {
  id        String   @id @default(cuid())
  level     String
  message   String
  context   String?
  createdAt DateTime @default(now())

  @@index([level])
  @@index([createdAt])
}

model DailyPerformance {
  id               String   @id @default(cuid())
  date             DateTime
  assetSymbol      String
  marketType       String
  totalPredictions Int      @default(0)
  totalTrades      Int      @default(0)
  wins             Int      @default(0)
  losses           Int      @default(0)
  winRate          Decimal  @default(0)
  totalProfit      Decimal  @default(0)
  averageRoi       Decimal  @default(0)
  bestStrategy     String?
  worstStrategy    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([date, assetSymbol, marketType])
  @@index([assetSymbol])
  @@index([marketType])
  @@index([createdAt])
}
